{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-blog",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/daily-blog",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/cron/daily-blog.js": {
      "maxDuration": 300
    }
  }
}