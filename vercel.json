{
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.ecomxtra.in"
        }
      ],
      "destination": "https://ecomxtra.in/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/render-page?path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/render-page?path=/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-blog",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/daily-blog",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/cron/daily-blog.js": {
      "maxDuration": 300
    },
    "api/sitemap.js": {
      "maxDuration": 30
    },
    "api/render-page.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  }
}